// Advanced mode, compact window (CompactMain): header, Active / Waiting /
// Done tabs with counts, the list and a footer with the total speeds.
// The list and the footer are shared with the wide layout.
import { Theme } from "../theme.slint";
import { AdvRowVm, TabCountsVm } from "../types.slint";
import { ListView } from "std-widgets.slint";
import { Pressable, TextButton, QuietButton } from "../widgets.slint";
import { Icon } from "../icons.slint";
import { ScreenBar } from "../chrome.slint";
import { LinkField } from "../welcome.slint";
import { AdvRow } from "row.slint";
import { WhenDoneUi } from "whendone.slint";
import { UpdateUi, UpdateBanner } from "../update.slint";

component AdvTab inherits Pressable {
    in property <string> text;
    in property <int> count;
    in property <bool> selected;

    height: 28px;
    min-width: 0;
    preferred-width: 0;
    horizontal-stretch: 1;
    border-radius: 7px;
    background: selected ? Theme.panel : root.hovered ? Theme.hover : transparent;
    drop-shadow-color: selected ? #0000001F : transparent;
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 2px;
    accessible-role: tab;
    accessible-label: text;
    accessible-value: count;
    accessible-item-selectable: true;
    accessible-item-selected: selected;

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 13px;
            font-weight: root.selected ? 600 : 500;
            color: root.selected ? Theme.text : Theme.muted;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: root.count;
            vertical-alignment: center;
            font-size: 11.5px;
            font-weight: 500;
            color: Theme.muted;
            accessible-role: none;
        }
    }
}

// The rows, or a line saying why there are none.
export component AdvList inherits Rectangle {
    in property <[AdvRowVm]> rows;
    in property <string> empty-text;
    callback select(int);
    callback pause(int);
    callback resume(int);
    callback retry(int);
    callback stop-recording(int);
    callback open-file(int);

    // One list view for every tab and filter (it keeps its scroll
    // position); the empty text lies over it.
    ListView {
        for r in root.rows: HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-bottom: 2px;
            AdvRow {
                item: r;
                select(id) => {
                    root.select(id);
                }
                pause(id) => {
                    root.pause(id);
                }
                resume(id) => {
                    root.resume(id);
                }
                retry(id) => {
                    root.retry(id);
                }
                stop-recording(id) => {
                    root.stop-recording(id);
                }
                open-file(id) => {
                    root.open-file(id);
                }
            }
        }
    }
    if root.rows.length == 0: Text {
        x: 16px;
        width: parent.width - 32px;
        text: root.empty-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        font-size: 13px;
        color: Theme.muted;
    }
}

// Total download and upload speed, the when-done and speed button and
// Pause all / Resume all.
export component SpeedFooter inherits Rectangle {
    in property <string> down;
    in property <string> up;
    in property <bool> all-paused;
    // The when-done button: opens the when-done and speed popover.
    callback open-whendone();
    callback pause-all();
    callback resume-all();

    property <bool> chosen: WhenDoneUi.when-done != "" && WhenDoneUi.when-done != "nothing";
    // A window under 400 px: Pause all / Resume all keeps only its icon.
    in property <bool> narrow;

    height: 40px;
    background: Theme.toolbar;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 4px;
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "arrow-down";
                    width: 13px;
                    height: 13px;
                    stroke: Theme.accent-ink;
                }
            }
            Text {
                text: root.down;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
                accessible-role: text;
                accessible-label: @tr("↓ {0}", root.down);
            }
        }
        HorizontalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "up";
                    width: 13px;
                    height: 13px;
                    stroke: Theme.muted;
                }
            }
            Text {
                text: root.up;
                vertical-alignment: center;
                font-size: 12px;
                color: Theme.muted;
                horizontal-stretch: 1;
                min-width: 0;
                overflow: elide;
                accessible-role: text;
                accessible-label: @tr("↑ {0}", root.up);
            }
        }
        VerticalLayout {
            alignment: center;
            Pressable {
                height: 28px;
                width: root.chosen ? whendone-row.preferred-width + 20px : 28px;
                border-radius: 7px;
                background: root.chosen ? Theme.sel : self.pressed ? Theme.track : self.hovered ? Theme.hover : transparent;
                accessible-label: whendone-label.text;
                clicked => {
                    root.open-whendone();
                }
                whendone-row := HorizontalLayout {
                    alignment: center;
                    spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "moon";
                            width: 14px;
                            height: 14px;
                            stroke: root.chosen ? Theme.accent-ink : Theme.muted;
                        }
                    }
                    whendone-label := Text {
                        visible: root.chosen;
                        // Long labels elide rather than push Pause all out.
                        width: root.chosen ? min(self.preferred-width, 110px) : 0;
                        overflow: elide;
                        text: WhenDoneUi.footer-label(WhenDoneUi.when-done);
                        vertical-alignment: center;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.accent-ink;
                        accessible-role: none;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            TextButton {
                height: 28px;
                // Never squeezed: it shows its whole label, or only its icon.
                min-width: self.preferred-width;
                kind: "muted";
                font-size: 12px;
                icon: root.all-paused ? "play" : "pause";
                text: root.narrow ? "" : self.accessible-label;
                accessible-label: root.all-paused ? @tr("Resume all") : @tr("Pause all");
                clicked => {
                    if (root.all-paused) {
                        root.resume-all();
                    } else {
                        root.pause-all();
                    }
                }
            }
        }
    }
}

export component AdvCompact inherits Rectangle {
    in property <[AdvRowVm]> rows;
    in property <TabCountsVm> counts;
    in-out property <int> tab;
    in property <string> speed-down;
    in property <string> speed-up;
    callback tab-changed(int);
    callback select(int);
    callback link-entered(string);
    // The "+" panel's other ways to add: several links, links of a page.
    callback open-batch();
    callback open-grab();
    callback open-settings();
    callback pause(int);
    callback resume(int);
    callback retry(int);
    callback stop-recording(int);
    callback open-file(int);
    // The footer's when-done button.
    callback open-whendone();

    in property <bool> all-paused;
    in property <bool> narrow;
    callback pause-all();
    callback resume-all();

    function pick(i: int) {
        root.tab = i;
        root.tab-changed(i);
    }

    VerticalLayout {
        ScreenBar {
            title: "Hyades";
            back: false;
            QuietButton {
                icon-size: 17px;
                icon: "settings";
                label: @tr("Settings");
                clicked => {
                    root.open-settings();
                }
            }
        }

        HorizontalLayout {
            padding: 12px;
            padding-bottom: 8px;
            spacing: 8px;
            link := LinkField {
                field-height: 36px;
                pill: false;
                show-icon: true;
                inline-button: false;
                entered(l) => {
                    root.link-entered(l);
                }
            }
            TextButton {
                height: 36px;
                min-width: 0;
                kind: "primary";
                text: @tr("Add");
                enabled: link.has-text;
                clicked => {
                    link.send();
                }
            }
            QuietButton {
                size: 36px;
                outlined: true;
                icon: "list";
                label: @tr("Several links…");
                clicked => {
                    root.open-batch();
                }
            }
            QuietButton {
                size: 36px;
                outlined: true;
                icon: "globe";
                label: @tr("Grab links from a page…");
                clicked => {
                    root.open-grab();
                }
            }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 6px;
            Rectangle {
                background: Theme.chip;
                border-radius: 9px;
                accessible-role: tab-list;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;
                    AdvTab {
                        text: @tr("Active");
                        count: root.counts.active;
                        selected: root.tab == 0;
                        clicked => {
                            root.pick(0);
                        }
                    }
                    AdvTab {
                        text: @tr("Waiting");
                        count: root.counts.waiting;
                        selected: root.tab == 1;
                        clicked => {
                            root.pick(1);
                        }
                    }
                    AdvTab {
                        text: @tr("Done");
                        count: root.counts.done;
                        selected: root.tab == 2;
                        clicked => {
                            root.pick(2);
                        }
                    }
                }
            }
        }

        if UpdateUi.banner: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            UpdateBanner { }
        }

        AdvList {
            vertical-stretch: 1;
            rows: root.rows;
            empty-text: root.tab == 0 ? @tr("Nothing is downloading right now.")
                : root.tab == 1 ? @tr("Nothing is waiting.") : @tr("Finished downloads show up here.");
            select(id) => {
                root.select(id);
            }
            pause(id) => {
                root.pause(id);
            }
            resume(id) => {
                root.resume(id);
            }
            retry(id) => {
                root.retry(id);
            }
            stop-recording(id) => {
                root.stop-recording(id);
            }
            open-file(id) => {
                root.open-file(id);
            }
        }

        SpeedFooter {
            down: root.speed-down;
            up: root.speed-up;
            all-paused: root.all-paused;
            narrow: root.narrow;
            open-whendone => { root.open-whendone(); }
            pause-all => { root.pause-all(); }
            resume-all => { root.resume-all(); }
        }
    }
}
