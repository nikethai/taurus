// Advanced mode dialogs, laid over the whole window: removing a download
// (finished files stay unless asked; an unfinished download's partial
// files go). The sign-in dialog, shared with Simple mode, is in
// ../dialogs.slint.
import { Theme } from "../theme.slint";
import { RemoveDialogVm } from "../types.slint";
import { CheckBox, TextButton } from "../widgets.slint";
import { Scrim } from "../dialogs.slint";

export component RemoveDialog inherits Scrim {
    in property <RemoveDialogVm> dialog;
    // id, whether finished files go too (an unfinished download's
    // partial files always do)
    callback confirm(int, bool);
    callback cancel();

    // Unticked each time the dialog opens: finished files are kept unless
    // asked.
    property <bool> delete-files: false;

    first-focused: delete.focused;
    last-focused: remove.focused;
    init => {
        root.take-focus();
    }
    escape => {
        root.cancel();
    }
    enter => {
        root.confirm(root.dialog.id, root.delete-files);
    }
    wrap(forward) => {
        if (forward) {
            delete.focus();
        } else {
            remove.focus();
        }
    }

    Text {
        text: @tr("Remove {0} from the list?", root.dialog.name);
        wrap: word-wrap;
        font-size: 15px;
        font-weight: 700;
        color: Theme.text;
        accessible-role: text;
        accessible-label: self.text;
    }
    // Space or Return on the box ticks it; it never removes.
    delete := CheckBox {
        text: @tr("Also delete the files");
        checked <=> root.delete-files;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        TextButton {
            text: @tr("Cancel");
            kind: "quiet";
            clicked => {
                root.cancel();
            }
        }
        remove := TextButton {
            text: @tr("Remove");
            kind: "primary";
            clicked => {
                root.confirm(root.dialog.id, root.delete-files);
            }
        }
    }
}
