// Wide layout sidebar: Library (All … Failed) and Sources (HTTP, Torrents,
// Media) with their counts. Picking an entry sets `filter`.
import { Theme } from "../theme.slint";
import { FilterCountVm } from "../types.slint";
import { Pressable, SectionTitle } from "../widgets.slint";

component SidebarItem inherits Pressable {
    in property <string> text;
    in property <int> count;
    in property <bool> selected;

    height: 32px;
    border-radius: 8px;
    background: selected ? Theme.sel : root.hovered ? Theme.chip : transparent;
    accessible-role: list-item;
    accessible-label: text;
    accessible-value: count;
    accessible-item-selectable: true;
    accessible-item-selected: selected;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            color: Theme.text;
            accessible-role: none;
        }
        Text {
            text: root.count;
            vertical-alignment: center;
            font-size: 12px;
            color: Theme.muted;
            accessible-role: none;
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[FilterCountVm]> counts;
    in-out property <string> filter;
    callback filter-changed(string);

    pure function label(key: string) -> string {
        if (key == "downloading") {
            return @tr("Downloading");
        } else if (key == "queued") {
            return @tr("Queued");
        } else if (key == "paused") {
            return @tr("Paused");
        } else if (key == "completed") {
            return @tr("Completed");
        } else if (key == "failed") {
            return @tr("Failed");
        } else if (key == "http") {
            return @tr("HTTP");
        } else if (key == "torrents") {
            return @tr("Torrents");
        } else if (key == "media") {
            return @tr("Media");
        }
        return @tr("All");
    }

    background: Theme.chip;

    VerticalLayout {
        padding: 12px;
        padding-top: 16px;
        spacing: 2px;
        alignment: start;
        SectionTitle {
            height: 22px;
            text: @tr("Library");
        }
        // Counts come in sidebar order; Sources start at "http".
        for c in root.counts: VerticalLayout {
            spacing: 2px;
            if c.key == "http": SectionTitle {
                height: 34px;
                text: @tr("Sources");
            }
            SidebarItem {
                text: root.label(c.key);
                count: c.count;
                selected: root.filter == c.key;
                clicked => {
                    root.filter = c.key;
                    root.filter-changed(c.key);
                }
            }
        }
    }
}
