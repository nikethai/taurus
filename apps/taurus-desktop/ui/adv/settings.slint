// Advanced Settings (CompactSettings / Settings): every section on one
// scrolling page in the compact layout; in the wide layout a list of the
// sections on the left and the chosen one beside it. What it shows and
// asks of the app goes through `SettingsUi`.
import { Theme } from "../theme.slint";
import { ScreenBar, BarFooter } from "../chrome.slint";
import { ScrollView } from "std-widgets.slint";
import { Pressable, Card } from "../widgets.slint";
import { SettingsUi } from "settings_ui.slint";
import { DownloadsSection, TorrentsSection, NetworkSection } from "settings_sections.slint";
import { EnginesSection, AppearanceSection, PrivacySection, GeneralSection } from "settings_more.slint";

component SectionItem inherits Pressable {
    in property <string> text;
    in property <bool> selected;

    height: 34px;
    border-radius: 8px;
    background: selected ? Theme.sel : root.hovered ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: text;
    accessible-item-selectable: true;
    accessible-item-selected: selected;

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        vertical-alignment: center;
        overflow: elide;
        font-size: 13px;
        font-weight: root.selected ? 600 : 500;
        color: root.selected ? Theme.accent-ink : Theme.text;
        accessible-role: none;
    }
}

export component AdvSettings inherits FocusScope {
    // The section list and one section at a time.
    in property <bool> wide;
    callback back();

    property <[{key: string, label: string}]> sections: [
        { key: "downloads", label: @tr("Downloads") },
        { key: "torrents", label: @tr("Torrents") },
        { key: "network", label: @tr("Network") },
        { key: "engines", label: @tr("Engines") },
        { key: "appearance", label: @tr("Appearance") },
        { key: "privacy", label: @tr("Privacy") },
        { key: "general", label: @tr("General") },
    ];

    pure function shows(key: string) -> bool {
        return !root.wide || SettingsUi.section == key;
    }

    // Escape goes back (like Back), from anywhere on the screen.
    focus-on-tab-navigation: false;
    init => {
        SettingsUi.opened();
        self.focus();
    }
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            SettingsUi.leave();
            root.back();
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        ScreenBar {
            title: @tr("Settings");
            back-clicked => {
                SettingsUi.leave();
                root.back();
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            if root.wide: Rectangle {
                width: 220px;
                background: Theme.toolbar;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }
                VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    alignment: start;
                    for s in root.sections: SectionItem {
                        text: s.label;
                        selected: SettingsUi.section == s.key;
                        clicked => {
                            SettingsUi.leave();
                            SettingsUi.section = s.key;
                        }
                    }
                }
            }
            ScrollView {
                horizontal-stretch: 1;
                VerticalLayout {
                    // Wide: a column of at most 720 px.
                    padding-left: root.wide ? 32px : 12px;
                    padding-right: root.wide ? max(32px, root.width - 220px - 32px - 720px) : 12px;
                    padding-top: root.wide ? 24px : 14px;
                    padding-bottom: 20px;
                    spacing: 18px;
                    alignment: start;
                    if root.shows("downloads"): Card { padding-y: 12px; DownloadsSection { } }
                    if root.shows("torrents"): Card { padding-y: 12px; TorrentsSection { } }
                    if root.shows("network"): Card { padding-y: 12px; NetworkSection { } }
                    if root.shows("engines"): Card { padding-y: 12px; EnginesSection { } }
                    if root.shows("appearance"): Card { padding-y: 12px; AppearanceSection { } }
                    if root.shows("privacy"): Card { padding-y: 12px; PrivacySection { } }
                    if root.shows("general"): Card { padding-y: 12px; GeneralSection { } }
                }
            }
        }
    }
}
