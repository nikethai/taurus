// Advanced mode, wide layout (Main, window at least 900 px wide): sidebar,
// then search and the list. The detail pane beside them is laid out by
// the window (`DetailPane`, shared with the compact layout).
import { Theme } from "../theme.slint";
import { AdvRowVm, FilterCountVm } from "../types.slint";
import { Pressable, TextButton, LineEdit } from "../widgets.slint";
import { Icon } from "../icons.slint";
import { LinkField } from "../welcome.slint";
import { AdvList, SpeedFooter } from "main.slint";
import { Sidebar } from "sidebar.slint";
import { UpdateUi, UpdateBanner } from "../update.slint";

export component AdvWide inherits Rectangle {
    in property <[AdvRowVm]> rows;
    in property <[FilterCountVm]> counts;
    in-out property <string> filter;
    in property <string> speed-down;
    in property <string> speed-up;
    // What the list is filtered by; outlives this component.
    in-out property <string> search-text;
    callback filter-changed(string);
    callback search-changed(string);
    callback select(int);
    callback link-entered(string);
    // The "+" panel's other ways to add: several links, links of a page.
    callback open-batch();
    callback open-grab();
    callback open-settings();
    callback pause(int);
    callback resume(int);
    callback retry(int);
    callback stop-recording(int);
    callback open-file(int);
    // The footer's when-done button.
    callback open-whendone();

    in property <bool> all-paused;
    callback pause-all();
    callback resume-all();

    property <bool> pasting: false;

    HorizontalLayout {
        Sidebar {
            width: 220px;
            counts: root.counts;
            filter <=> root.filter;
            filter-changed(key) => {
                root.filter-changed(key);
            }
            open-settings => {
                root.open-settings();
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.line;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            HorizontalLayout {
                height: 56px;
                padding-left: 20px;
                padding-right: 16px;
                spacing: 8px;
                Text {
                    text: @tr("Downloads");
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                }
                VerticalLayout {
                    alignment: center;
                    LineEdit {
                        width: 240px;
                        text <=> root.search-text;
                        placeholder-text: @tr("Search downloads");
                        accessible-label: @tr("Search downloads");
                        edited(text) => {
                            root.search-changed(text);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    add-button := Pressable {
                        height: 32px;
                        width: add-row.preferred-width + 24px;
                        border-radius: 8px;
                        background: root.pasting ? (self.hovered ? Theme.track : Theme.chip)
                            : self.pressed ? Theme.accent-strong.darker(0.15) : Theme.accent-strong;
                        accessible-label: root.pasting ? @tr("Close the link field") : @tr("Add a download");
                        clicked => {
                            root.pasting = !root.pasting;
                        }
                        add-row := HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: root.pasting ? "close" : "plus";
                                    width: 14px;
                                    height: 14px;
                                    stroke: root.pasting ? Theme.text : Theme.accent-text;
                                }
                            }
                            Text {
                                text: @tr("New download");
                                vertical-alignment: center;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.pasting ? Theme.text : Theme.accent-text;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
            // Escape from the field closes the panel; the focus goes back to "+".
            if root.pasting: FocusScope {
                focus-on-tab-navigation: false;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.pasting = false;
                        add-button.focus();
                        return accept;
                    }
                    return reject;
                }
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 6px;
                    LinkField {
                        field-height: 36px;
                        pill: false;
                        show-icon: true;
                        init => {
                            self.focus-input();
                        }
                        entered(link) => {
                            root.pasting = false;
                            root.link-entered(link);
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        TextButton {
                            text: @tr("Several links…");
                            kind: "quiet";
                            clicked => {
                                root.pasting = false;
                                root.open-batch();
                            }
                        }
                        TextButton {
                            text: @tr("Grab links from a page…");
                            kind: "quiet";
                            clicked => {
                                root.pasting = false;
                                root.open-grab();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            if UpdateUi.banner: HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                UpdateBanner { }
            }
            AdvList {
                vertical-stretch: 1;
                rows: root.rows;
                empty-text: @tr("No downloads here.");
                select(id) => {
                    root.select(id);
                }
                pause(id) => {
                    root.pause(id);
                }
                resume(id) => {
                    root.resume(id);
                }
                retry(id) => {
                    root.retry(id);
                }
                stop-recording(id) => {
                    root.stop-recording(id);
                }
                open-file(id) => {
                    root.open-file(id);
                }
            }
            SpeedFooter {
                down: root.speed-down;
                up: root.speed-up;
                all-paused: root.all-paused;
                open-whendone => { root.open-whendone(); }
                pause-all => { root.pause-all(); }
                resume-all => { root.resume-all(); }
            }
        }
    }
}
