// Pieces of the Advanced detail (detail.slint): the segment map and
// "label  value" lines.
import { Theme } from "../theme.slint";

// Cells per row of the segment map; 96 cells make 4 rows.
global Map {
    out property <int> columns: 24;
    out property <length> cell-height: 10px;
    out property <length> gap: 2px;
}

// A web download's segment map: how much of each part is written.
export component SegmentMap inherits Rectangle {
    in property <[float]> cells;
    in property <string> kind;
    in property <string> percent;

    property <length> cell-width: (self.width - (Map.columns - 1) * Map.gap) / Map.columns;
    height: ceil(cells.length / Map.columns) * (Map.cell-height + Map.gap) - Map.gap;
    accessible-role: progress-indicator;
    accessible-label: @tr("Segment map");
    accessible-value: percent;

    for c[i] in root.cells: Rectangle {
        x: mod(i, Map.columns) * (root.cell-width + Map.gap);
        y: floor(i / Map.columns) * (Map.cell-height + Map.gap);
        width: root.cell-width;
        height: Map.cell-height;
        border-radius: 2px;
        background: Theme.track;
        Rectangle {
            border-radius: parent.border-radius;
            background: Theme.kind-fg(root.kind);
            opacity: c <= 0 ? 0 : 0.35 + 0.65 * c;
        }
    }
}

// "label  value" on one line.
export component Pair inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 10px;
    Text {
        text: root.label;
        width: 96px;
        wrap: word-wrap;
        font-size: 12px;
        color: Theme.muted;
        accessible-role: none;
    }
    // Long links and folders wrap anywhere instead of widening the pane.
    Text {
        text: root.value;
        horizontal-stretch: 1;
        wrap: word-wrap;
        overflow: elide;
        font-size: 12px;
        color: Theme.text;
        accessible-role: text;
        accessible-label: @tr("{0}: {1}", root.label, root.value);
    }
}

export component SectionLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.muted;
    accessible-role: none;
}
