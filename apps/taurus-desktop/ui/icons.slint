import { Theme } from "theme.slint";

// Self-authored 24x24 stroke icons (no third-party artwork, no licence needed).
export component Icon inherits Path {
    in property <string> name;

    pure function shape(n: string) -> string {
        if (n == "down") {
            return "M12 4 V16 M6 11 L12 17 L18 11 M5 21 H19";
        } else if (n == "plus") {
            return "M12 5 V19 M5 12 H19";
        } else if (n == "pause") {
            return "M8 5 V19 M16 5 V19";
        } else if (n == "play") {
            return "M7 4 L19 12 L7 20 Z";
        } else if (n == "stop") {
            return "M6 6 H18 V18 H6 Z";
        } else if (n == "retry") {
            return "M20 12 A8 8 0 1 1 17.66 6.34 L20 8.5 M20 3.5 V8.5 H15";
        } else if (n == "folder") {
            return "M3 7 A2 2 0 0 1 5 5 H9 L11 7.5 H19 A2 2 0 0 1 21 9.5 V17 A2 2 0 0 1 19 19 H5 A2 2 0 0 1 3 17 Z";
        } else if (n == "trash") {
            return "M4 7 H20 M10 11 V17 M14 11 V17 M6 7 L7 19 A2 2 0 0 0 9 21 H15 A2 2 0 0 0 17 19 L18 7 M9 7 V4 H15 V7";
        } else if (n == "settings") {
            return "M4 7 H14 M18 7 H20 M4 17 H6 M10 17 H20 M16 4 V10 M8 14 V20";
        } else if (n == "close") {
            return "M6 6 L18 18 M18 6 L6 18";
        } else if (n == "back") {
            return "M19 12 H5 M11 6 L5 12 L11 18";
        } else if (n == "disc") {
            return "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z M14.5 12 A2.5 2.5 0 1 1 9.5 12 A2.5 2.5 0 1 1 14.5 12 Z";
        } else if (n == "media") {
            return "M5 4 H19 A2 2 0 0 1 21 6 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 V6 A2 2 0 0 1 5 4 Z M10 9 L15 12 L10 15 Z";
        } else if (n == "magnet") {
            return "M5 3 V12 A7 7 0 0 0 19 12 V3 H15 V12 A3 3 0 0 1 9 12 V3 Z M5 8 H9 M15 8 H19";
        } else if (n == "archive") {
            return "M4 5 H20 V9 H4 Z M5 9 V19 H19 V9 M10 13 H14";
        } else if (n == "music") {
            return "M9 18 V5 L20 3 V16 M9 18 A3 3 0 1 1 3 18 A3 3 0 1 1 9 18 Z M20 16 A3 3 0 1 1 14 16 A3 3 0 1 1 20 16 Z";
        } else if (n == "image") {
            return "M5 4 H19 A2 2 0 0 1 21 6 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 V6 A2 2 0 0 1 5 4 Z M3 16 L8 11 L13 16 L16 13 L21 18 M9 8 A1 1 0 1 1 7 8 A1 1 0 1 1 9 8 Z";
        } else if (n == "live") {
            return "M13.5 12 A1.5 1.5 0 1 1 10.5 12 A1.5 1.5 0 1 1 13.5 12 Z M8 8 A5.5 5.5 0 0 0 8 16 M16 8 A5.5 5.5 0 0 1 16 16 M5 5 A10 10 0 0 0 5 19 M19 5 A10 10 0 0 1 19 19";
        } else if (n == "link") {
            return "M9 7 H7 A5 5 0 0 0 7 17 H9 M15 7 H17 A5 5 0 0 1 17 17 H15 M8 12 H16";
        } else if (n == "check") {
            return "M4 12.5 L9.5 18 L20 6.5";
        } else if (n == "moon") {
            return "M20 14.5 A8.5 8.5 0 1 1 9.5 4 A6.5 6.5 0 0 0 20 14.5 Z";
        }
        // "file" and any unknown name
        return "M14 3 H7 A2 2 0 0 0 5 5 V19 A2 2 0 0 0 7 21 H17 A2 2 0 0 0 19 19 V8 Z M14 3 V8 H19";
    }

    viewbox-width: 24;
    viewbox-height: 24;
    width: 24px;
    height: 24px;
    commands: shape(name);
    fill: transparent;
    stroke: Theme.text;
    stroke-width: 1.75px;
    stroke-line-cap: round;
    stroke-line-join: round;
}
