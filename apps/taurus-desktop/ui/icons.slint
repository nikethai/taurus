import { Theme } from "theme.slint";

// Self-authored 24x24 stroke icons (no third-party artwork, no licence needed).
export component Icon inherits Path {
    in property <string> name;

    pure function shape(n: string) -> string {
        if (n == "down") {
            return "M12 4v11M7 10.5l5 5 5-5M5 20h14";
        } else if (n == "plus") {
            return "M12 5 V19 M5 12 H19";
        } else if (n == "pause") {
            return "M9 5.5v13M15 5.5v13";
        } else if (n == "play") {
            return "M8 5.5v13l10.5-6.5z";
        } else if (n == "stop") {
            return "M7 7h10v10H7z";
        } else if (n == "retry") {
            return "M4.5 12a7.5 7.5 0 0 1 13.4-4.6M19.5 12a7.5 7.5 0 0 1-13.4 4.6M18.5 3.5v4h-4M5.5 20.5v-4h4";
        } else if (n == "folder") {
            return "M3.5 7V18a1.5 1.5 0 0 0 1.5 1.5h14a1.5 1.5 0 0 0 1.5-1.5V9a1.5 1.5 0 0 0-1.5-1.5h-7L10 5H5a1.5 1.5 0 0 0-1.5 1.5z";
        } else if (n == "trash") {
            return "M4 7h16M10 7V4.5h4V7M6.5 7l.9 12.5h9.2L17.5 7";
        } else if (n == "settings") {
            return "M4 7h9M17 7h3M4 17h3M11 17h9M15 5v4M9 15v4";
        } else if (n == "close") {
            return "M6 6 L18 18 M18 6 L6 18";
        } else if (n == "back") {
            return "M19 12 H5 M11 6 L5 12 L11 18";
        } else if (n == "disc") {
            return "M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16M12 10a2 2 0 1 0 0 4a2 2 0 1 0 0-4";
        } else if (n == "media") {
            return "M5 5h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM10 9v6l5-3z";
        } else if (n == "magnet") {
            return "M6 4h4v7a2 2 0 0 0 4 0V4h4v7a6 6 0 0 1-12 0zM6 8h4M14 8h4";
        } else if (n == "archive") {
            return "M4 5h16v4H4zM5.5 9v10h13V9M10 13h4";
        } else if (n == "music") {
            return "M9 17.5V6l10-2v11.5M9 17.5a2 2 0 1 1-4 0a2 2 0 1 1 4 0M19 15.5a2 2 0 1 1-4 0a2 2 0 1 1 4 0";
        } else if (n == "image") {
            return "M4 5h16v14H4zM4 15l4.5-4.5 4 4 2.5-2.5L20 17M15.5 8.5v.01";
        } else if (n == "live") {
            return "M12 10.5a1.5 1.5 0 1 0 0 3a1.5 1.5 0 1 0 0-3M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8";
        } else if (n == "link") {
            return "M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1";
        } else if (n == "check") {
            return "M5 12.5l4.5 4.5L19 7.5";
        } else if (n == "chevron") {
            return "M9 6 L15 12 L9 18";
        } else if (n == "chevron-down") {
            return "M6 9 L12 15 L18 9";
        } else if (n == "moon") {
            return "M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5z";
        } else if (n == "globe") {
            return "M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16M4 12h16M12 4c2.5 2.2 3.5 5 3.5 8s-1 5.8-3.5 8M12 4c-2.5 2.2-3.5 5-3.5 8s1 5.8 3.5 8";
        } else if (n == "inbox") {
            return "M4 13.5L6.2 5h11.6l2.2 8.5V19H4zM4 13.5h4.5l1.2 2h4.6l1.2-2H20";
        } else if (n == "alert") {
            return "M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16M12 8v5M12 16v.01";
        } else if (n == "list") {
            return "M9 6h11M9 12h11M9 18h11M4.5 6v.01M4.5 12v.01M4.5 18v.01";
        } else if (n == "up") {
            return "M12 19V5M6.5 10.5L12 5l5.5 5.5";
        } else if (n == "arrow-down") {
            return "M12 5v14M6.5 13.5L12 19l5.5-5.5";
        } else if (n == "clock") {
            return "M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16M12 8v4.5l3 2";
        } else if (n == "copy") {
            return "M9 9h10v10H9zM15 9V5H5v10h4";
        } else if (n == "search") {
            return "M11 5a6 6 0 1 0 0 12a6 6 0 1 0 0-12M19.5 19.5l-4.2-4.2";
        }
        // "file" and any unknown name
        return "M7 3.5h7l4.5 4.5v12.5H7zM14 3.5V8h4.5";
    }

    viewbox-width: 24;
    viewbox-height: 24;
    width: 24px;
    height: 24px;
    commands: shape(name);
    fill: transparent;
    stroke: Theme.text;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
}
