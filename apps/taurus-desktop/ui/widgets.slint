// Small controls shared by the screens. Colors come from Theme only.
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { LineEdit as StdLineEdit, TextEdit as StdTextEdit } from "std-widgets.slint";

// Anything clickable: mouse, keyboard (Tab, then Space or Return) and
// assistive technology (default action) all call `clicked`. A held key
// clicks once: its auto-repeats are ignored.
export component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    out property <bool> pressed: touch.pressed;
    out property <bool> hovered: touch.has-hover;
    // Has the keyboard focus; `focus()` gives it.
    out property <bool> focused: focus.has-focus;
    callback clicked();

    forward-focus: focus;

    accessible-role: button;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                if (!event.repeat) {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.accent-base;
    }
}

// Round icon-only button. Always set `label`: it is what screen readers say.
export component IconButton inherits Pressable {
    in property <string> icon;
    in property <string> label;
    // Accent fill instead of a quiet hover circle.
    in property <bool> filled: false;
    // A ringed circle on the panel color.
    in property <bool> outlined: false;
    in property <length> size: 36px;

    width: size;
    height: size;
    border-radius: self.height / 2;
    opacity: root.enabled ? 1 : 0.45;
    background: filled ? (root.pressed ? Theme.accent-strong.darker(0.15) : Theme.accent-strong)
        : root.pressed ? Theme.track : root.hovered ? Theme.chip : outlined ? Theme.panel : transparent;
    border-width: outlined ? 1px : 0;
    border-color: Theme.line;
    accessible-label: label;

    Icon {
        name: root.icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * (root.outlined ? 0.42 : 0.5);
        height: root.size * (root.outlined ? 0.42 : 0.5);
        stroke: root.filled ? Theme.accent-text : Theme.text;
    }
}

// Quiet icon-only button: a muted icon, a hover tint; `outlined` gives it
// a ring and 9 px corners (the link row's buttons). Always set `label`.
export component QuietButton inherits Pressable {
    in property <string> icon;
    in property <string> label;
    in property <length> size: 32px;
    in property <length> icon-size: 16px;
    in property <bool> outlined: false;

    width: size;
    height: size;
    border-radius: outlined ? 9px : 7px;
    border-width: outlined ? 1px : 0;
    border-color: Theme.line;
    background: root.pressed ? Theme.track : root.hovered ? Theme.hover : transparent;
    accessible-label: label;

    Icon {
        name: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        stroke: Theme.muted;
    }
}

// Text button. kind: primary (accent fill) | secondary (outlined) |
// plain (text only, hover tint) | muted (plain, muted text) | quiet
// (accent-colored text).
export component TextButton inherits Pressable {
    in property <string> text;
    in property <string> kind: "secondary";
    in property <length> font-size: 13px;
    // An icon before the text ("" for none).
    in property <string> icon;

    height: 32px;
    min-width: 64px;
    horizontal-stretch: 0;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.45;
    background: kind == "primary" ? (root.pressed ? Theme.accent-strong.darker(0.15) : Theme.accent-strong)
        : root.pressed ? Theme.track : root.hovered ? Theme.hover : kind == "secondary" ? Theme.panel : transparent;
    border-width: kind == "secondary" ? 1px : 0;
    border-color: Theme.line;
    accessible-label: text;

    HorizontalLayout {
        padding-left: root.kind == "primary" ? 14px : root.kind == "muted" ? 10px : 12px;
        padding-right: root.kind == "primary" ? 14px : root.kind == "muted" ? 10px : 12px;
        spacing: 5px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                width: root.font-size + 1px;
                height: root.font-size + 1px;
                stroke: label.color;
            }
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.font-size;
            font-weight: root.kind == "primary" || root.kind == "quiet" ? 600 : 500;
            // Squeezed by a long translation, the label elides; the
            // button never clips or leaves the window.
            overflow: elide;
            color: root.kind == "primary" ? Theme.accent-text
                : root.kind == "quiet" ? Theme.accent-ink
                : root.kind == "muted" ? Theme.muted : Theme.text;
            accessible-role: none;
        }
    }
}

// A check box drawn checked, with a dash, or empty.
export component TriBox inherits Rectangle {
    // "all" | "some" | "none"
    in property <string> state;

    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: root.state == "none" ? 1.5px : 0;
    border-color: Theme.muted;
    background: root.state == "none" ? transparent : Theme.accent-strong;

    if root.state == "all": Path {
        width: 11px;
        height: 11px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 2 6.5 L 5 9.5 L 10 3";
        stroke: Theme.accent-text;
        stroke-width: 2px;
        fill: transparent;
    }
    if root.state == "some": Rectangle {
        width: 10px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-text;
    }
}

// A check box with its label, in the accent color: a click, Space or
// Return toggles it (Return never reaches a dialog's Enter).
export component CheckBox inherits Pressable {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();

    min-height: 32px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: checked;
    clicked => {
        root.checked = !root.checked;
        root.toggled();
    }

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            TriBox {
                state: root.checked ? "all" : "none";
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            font-size: 13px;
            color: Theme.text;
            accessible-role: none;
        }
    }
}

// The std text fields with the focus line in the accent color: the std
// field fills the component, the line is drawn over its own. Assistive
// technology sees this component as the field.
export component LineEdit inherits Rectangle {
    in-out property <string> text <=> field.text;
    in property <string> placeholder-text <=> field.placeholder-text;
    in property <InputType> input-type <=> field.input-type;
    in property <bool> enabled <=> field.enabled;
    out property <bool> has-focus: field.has-focus;
    callback edited <=> field.edited;
    callback accepted <=> field.accepted;

    // Selects the whole text: what is typed next replaces it.
    public function select-all() {
        field.select-all();
    }

    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-action-set-value(v) => {
        root.text = v;
        root.edited(v);
    }
    forward-focus: field;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    min-width: field.min-width;
    min-height: field.min-height;
    preferred-width: field.preferred-width;
    preferred-height: field.preferred-height;

    field := StdLineEdit {
        width: root.width;
        height: root.height;
        accessible-role: none;
    }
    Rectangle {
        x: 4px;
        y: parent.height - self.height;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-base;
        visible: root.has-focus && root.enabled;
    }
}

export component TextEdit inherits Rectangle {
    in-out property <string> text <=> field.text;
    in property <TextWrap> wrap <=> field.wrap;
    out property <bool> has-focus: field.has-focus;
    callback edited <=> field.edited;

    accessible-role: text-input;
    accessible-value: root.text;
    accessible-action-set-value(v) => {
        root.text = v;
        root.edited(v);
    }
    forward-focus: field;
    horizontal-stretch: 1;
    min-width: field.min-width;
    min-height: field.min-height;
    preferred-width: field.preferred-width;
    preferred-height: field.preferred-height;

    field := StdTextEdit {
        width: root.width;
        height: root.height;
        accessible-role: none;
    }
    Rectangle {
        x: 4px;
        y: parent.height - self.height;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-base;
        visible: root.has-focus;
    }
}

// On/off switch with a label and an optional hint under it. The track
// is `track-width` wide (32, 36 or 40 px in the canvas).
export component Toggle inherits Pressable {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    in property <length> track-width: 32px;
    in property <length> label-size: 13px;

    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: root.label-size;
                font-weight: 500;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 11.5px;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.track-width;
                height: (root.track-width - 32px) / 2 + 20px;
                border-radius: self.height / 2;
                background: root.checked ? Theme.accent-strong : Theme.switch-off;
                animate background { duration: 120ms; }
                Rectangle {
                    width: parent.height - 6px;
                    height: self.width;
                    y: 3px;
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    border-radius: self.height / 2;
                    background: #FFFFFF;
                    drop-shadow-color: #0000004D;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-blur: 2px;
                    animate x {
                        duration: 120ms;
                        easing: ease-out;
                    }
                }
            }
        }
    }
}

// One option of a Segmented group.
export component Segment inherits Pressable {
    in property <string> text;
    in property <bool> selected;

    height: 28px;
    horizontal-stretch: 1;
    border-radius: 7px;
    background: selected ? Theme.panel : root.hovered ? Theme.hover : transparent;
    drop-shadow-color: selected ? #0000001F : transparent;
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 2px;
    accessible-role: radio-button;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: selected;

    // Bounded by the segment, so a long label elides inside it.
    Text {
        x: 2px;
        width: parent.width - 4px;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        font-weight: root.selected ? 600 : 500;
        color: root.selected ? Theme.text : Theme.muted;
        overflow: elide;
        accessible-role: none;
    }
}

// Track that holds Segments side by side.
export component Segmented inherits Rectangle {
    background: Theme.chip;
    border-radius: 9px;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        @children
    }
}

// Rounded square in the file kind's colors with its icon.
export component KindBadge inherits Rectangle {
    in property <string> kind;
    in property <length> size: 40px;

    width: size;
    height: size;
    border-radius: size / 4;
    background: Theme.kind-bg(kind);

    Icon {
        name: root.kind == "torrent" ? "magnet" : root.kind;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * 0.5;
        height: root.size * 0.5;
        stroke: Theme.kind-fg(root.kind);
    }
}

// Thin progress bar. progress < 0 means the size is unknown: a short
// segment slides along the track instead.
export component ProgressBar inherits Rectangle {
    in property <float> progress;
    in property <brush> bar-color: Theme.accent-base;
    in property <bool> moving: true;
    in property <length> thickness: 4px;

    height: thickness;
    border-radius: 2px;
    background: Theme.track;
    clip: true;
    accessible-role: progress-indicator;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value: progress < 0 ? "" : "\{round(clamp(progress, 0, 1) * 100)}";

    if root.progress >= 0: Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: parent.border-radius;
        background: root.bar-color;
    }
    if root.progress < 0: Rectangle {
        property <float> phase: root.moving ? mod(animation-tick() / 1400ms, 1) : 0.35;
        width: parent.width * 0.3;
        x: (parent.width + self.width) * phase - self.width;
        border-radius: parent.border-radius;
        background: root.bar-color;
    }
}

// Three dots that pulse while something loads.
export component LoadingDots inherits HorizontalLayout {
    spacing: 6px;
    alignment: center;
    for i in 3: Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent-base;
        opacity: 0.25 + 0.75 * abs(sin((animation-tick() / 1ms) * 0.18deg - i * 50deg));
    }
}

// Panel with rounded corners holding a group of controls.
export component Card inherits Rectangle {
    in property <length> padding-x: 12px;
    in property <length> padding-y: 2px;
    vertical-stretch: 0;
    background: Theme.panel;
    border-radius: 11px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        padding-top: root.padding-y;
        padding-bottom: root.padding-y;
        @children
    }
}

// Section title above a Card.
export component SectionTitle inherits Text {
    // Room above the title separates it from the previous group.
    height: 28px;
    vertical-alignment: bottom;
    color: Theme.muted;
    font-size: 12px;
    font-weight: 600;
    accessible-role: none;
}
