// Offer to download a link the user copied.
import { Theme } from "theme.slint";
import { BannerVm } from "types.slint";
import { IconButton, TextButton, KindBadge } from "widgets.slint";

export component Banner inherits Rectangle {
    in property <BannerVm> banner;
    callback download();
    callback dismiss();

    background: Theme.panel;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow;
    accessible-role: AccessibleRole.banner;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            KindBadge {
                kind: root.banner.kind != "" ? root.banner.kind : "link";
                size: 36px;
            }
        }
        Text {
            // A magnet link has no host to name.
            text: root.banner.host != "" ? @tr("Download the link you copied from {0}?", root.banner.host)
                : root.banner.kind == "magnet" ? @tr("Download the torrent link you copied?")
                : @tr("Download the link you copied?");
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            font-size: 13px;
            color: Theme.text;
            accessible-role: text;
            accessible-label: self.text;
        }
        VerticalLayout {
            alignment: center;
            TextButton {
                text: @tr("Download");
                kind: "primary";
                clicked => {
                    root.download();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: "close";
                label: @tr("Dismiss");
                size: 32px;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}

// Slim line on the Downloads screen while the video tools are fetched, or
// after fetching them failed.
export component ToolsBanner inherits Rectangle {
    // "installing" | "failed"
    in property <string> state;
    // 0-100, -1 = unknown
    in property <int> percent: -1;

    background: state == "failed" ? Theme.kind-bg("live") : Theme.accent-soft;
    border-radius: 10px;
    accessible-role: AccessibleRole.banner;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        Text {
            text: root.state == "failed" ? @tr("Couldn't get the video tools. Hyades will try again.")
                : root.percent >= 0 ? @tr("Getting video tools… {0}%", root.percent)
                : @tr("Getting video tools…");
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            font-size: 12px;
            color: root.state == "failed" ? Theme.err : Theme.text;
            accessible-role: text;
            accessible-label: self.text;
        }
    }
}
