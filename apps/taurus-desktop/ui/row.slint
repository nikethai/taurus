// One download in the list: kind badge, name, progress, status line and
// the action that fits the state.
import { Theme } from "theme.slint";
import { RowVm } from "types.slint";
import { RowText } from "row_text.slint";
import { IconButton, TextButton, KindBadge, ProgressBar } from "widgets.slint";

export component Row inherits Rectangle {
    in property <RowVm> item;
    callback pause(int);
    callback resume(int);
    callback retry(int);
    callback stop-recording(int);
    callback open-file(int);
    callback reveal(int);
    callback remove(int);

    property <bool> active: item.state == "downloading" || item.state == "recording";
    property <bool> shows-bar: (item.state == "downloading" || item.state == "paused" || item.state == "waiting"
        || item.state == "queued" || item.state == "recording") && (item.progress >= 0 || active);

    min-height: layout.min-height;
    preferred-height: layout.preferred-height;
    border-radius: 12px;
    background: hover.has-hover ? Theme.chip : transparent;
    accessible-role: list-item;
    accessible-label: item.name;

    hover := TouchArea { }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Show in folder");
                activated => {
                    root.reveal(root.item.id);
                }
            }
            MenuItem {
                title: @tr("Remove from list");
                activated => {
                    root.remove(root.item.id);
                }
            }
        }
    }

    layout := HorizontalLayout {
        padding: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            KindBadge {
                kind: root.item.kind;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            if root.shows-bar: ProgressBar {
                progress: root.item.progress;
                bar-color: root.item.state == "paused" ? Theme.muted : Theme.bar(root.item.kind);
                moving: root.active;
            }
            Text {
                text: RowText.status(root.item);
                color: root.item.state == "failed" ? Theme.err
                    : root.item.state == "recording" ? Theme.kind-fg("live") : Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: self.text;
            }
        }

        HorizontalLayout {
            alignment: center;
            horizontal-stretch: 0;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                if root.item.state == "done": IconButton {
                    icon: "folder";
                    label: @tr("Show in folder");
                    size: 32px;
                    clicked => {
                        root.reveal(root.item.id);
                    }
                }
                if root.item.state != "done": IconButton {
                    icon: "close";
                    label: @tr("Remove from list");
                    size: 32px;
                    clicked => {
                        root.remove(root.item.id);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                if root.item.state == "failed": TextButton {
                    text: @tr("Try again");
                    clicked => {
                        root.retry(root.item.id);
                    }
                }
                if root.item.state == "done": TextButton {
                    text: @tr("Open");
                    clicked => {
                        root.open-file(root.item.id);
                    }
                }
                if root.item.state == "paused": IconButton {
                    icon: "play";
                    label: @tr("Resume");
                    clicked => {
                        root.resume(root.item.id);
                    }
                }
                if root.item.state == "recording": TextButton {
                    text: @tr("Stop");
                    clicked => {
                        root.stop-recording(root.item.id);
                    }
                }
                if root.item.state == "downloading" || root.item.state == "waiting"
                    || root.item.state == "queued" || root.item.state == "seeding": IconButton {
                    icon: "pause";
                    label: @tr("Pause");
                    clicked => {
                        root.pause(root.item.id);
                    }
                }
            }
        }
    }
}
