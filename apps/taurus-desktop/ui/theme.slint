import { Palette } from "std-widgets.slint";

// Design tokens, from the design canvas (docs/design/canvas/*.dc.html):
// the light/dark grounds and neutrals, the six accents (base, strong,
// ink, soft, sel per scheme) and the file-type colors (light and dark).
export global Theme {
    // system (default, follows the OS) | light | dark
    in-out property <string> scheme: "system";
    // The std widgets' (fluent) palette is dark. sync-palette forces it
    // light or dark for the Light and Dark themes and resets it to
    // ColorScheme.unknown for System; with unknown, fluent paints from the
    // OS scheme the backend reports, live (unknown OS scheme: light). Slint
    // gives no other public read of the OS scheme, so under System this is
    // how the theme follows the OS.
    property <color> palette-ground: Palette.background;
    out property <bool> palette-dark: palette-ground.to-hsv().value < 0.5;
    out property <bool> dark: scheme == "dark" || (scheme != "light" && palette-dark);

    // Gives the std widgets (text fields, selects) the theme's scheme.
    // Called after `scheme` changed.
    public function sync-palette() {
        Palette.color-scheme = self.scheme == "dark" ? ColorScheme.dark
            : self.scheme == "light" ? ColorScheme.light
            : ColorScheme.unknown;
    }
    // aldebaran (default) | cobalt | jade | grape | rose | sky
    in-out property <string> accent: "aldebaran";

    out property <brush> bg: dark ? #1C1C1F : #FBFBFC;
    // Header bars and footers.
    out property <brush> toolbar: dark ? #232327 : #F3F3F5;
    out property <brush> panel: dark ? #26262A : #FFFFFF;
    out property <brush> line: dark ? #323238 : #E3E3E8;
    // Text field borders, and their fill.
    out property <brush> field: dark ? #4A4A53 : #C9C9D1;
    out property <brush> input: dark ? #26262B : #FFFFFF;
    out property <brush> text: dark ? #ECECF0 : #1B1B1F;
    out property <brush> muted: dark ? #A2A2AD : #5F5F69;
    out property <brush> chip: dark ? #2E2E34 : #ECECF0;
    out property <brush> track: dark ? #38383F : #E2E2E7;
    out property <brush> ok: dark ? #4CC79A : #1F7A5C;
    out property <brush> err: dark ? #FF6B5E : #BE3328;
    // A switch's track when off (its knob is always white).
    out property <brush> switch-off: dark ? #6E6E79 : #8E8E99;
    // Hover tint over any ground.
    out property <brush> hover: dark ? #FFFFFF0E : #0000000B;
    // Soft shadow under floating cards (banner, countdown).
    out property <color> shadow: dark ? #00000066 : #0000001F;
    // Dims the window behind a dialog.
    out property <color> scrim: dark ? #000000A0 : #00000059;

    // Swatch color of an accent by name (its light base); unknown names
    // are Aldebaran.
    public pure function accent-of(name: string) -> color {
        if (name == "cobalt") {
            return #2F6FDE;
        } else if (name == "jade") {
            return #0F9D76;
        } else if (name == "grape") {
            return #7C3AED;
        } else if (name == "rose") {
            return #E11D48;
        } else if (name == "sky") {
            return #0284C7;
        }
        return #E8590C;
    }

    property <color> base-raw: !dark ? accent-of(accent)
        : accent == "cobalt" ? #5B8FF0
        : accent == "jade" ? #2CC799
        : accent == "grape" ? #A78BFA
        : accent == "rose" ? #FB7185
        : accent == "sky" ? #38BDF8
        : #FF7A2E;

    // Bars, focus rings, switches, check boxes.
    out property <brush> accent-base: base-raw;
    // Fill of primary buttons (white text on it meets AA in both schemes).
    out property <brush> accent-strong: accent == "cobalt" ? (dark ? #2F62C8 : #2457B8)
        : accent == "jade" ? #0B7258
        : accent == "grape" ? #6D28D9
        : accent == "rose" ? #BE123C
        : accent == "sky" ? #0369A1
        : #C2410C;
    // Accent-colored text and icons on the ground.
    out property <brush> accent-ink: !dark ? (accent == "aldebaran" || accent == "" ? #B3410A : accent-strong)
        : accent == "cobalt" ? #8DB2FF
        : accent == "jade" ? #5ADBB3
        : accent == "grape" ? #C4B5FD
        : accent == "rose" ? #FDA4AF
        : accent == "sky" ? #7DD3FC
        : #FF9A5C;
    // Text/icon color placed on an accent fill.
    out property <brush> accent-text: #FFFFFF;
    // Selected-but-not-done cells, chosen tiles' rings.
    out property <brush> accent-soft: base-raw.with-alpha(dark ? 0.38 : 0.3);
    // Selected rows and chosen tiles.
    out property <brush> sel: base-raw.with-alpha(dark ? 0.13 : 0.08);
    // Progress bars take their file kind's color (ui.progress_by_type),
    // else the accent.
    in-out property <bool> by-type: true;

    public pure function bar(kind: string) -> brush {
        return by-type ? kind-fg(kind) : accent-base;
    }

    // Kinds: disc, media, torrent (also magnet), archive, music, image, live;
    // anything else is "file".
    public pure function kind-bg(kind: string) -> brush {
        if (kind == "disc") {
            return dark ? #5B8FF02E : #E3EDFF;
        } else if (kind == "media") {
            return dark ? #9B78FF33 : #EEE6FF;
        } else if (kind == "torrent" || kind == "magnet") {
            return dark ? #2CC7AA2E : #DDF4EF;
        } else if (kind == "archive") {
            return dark ? #F5B43C2E : #FFF1D6;
        } else if (kind == "music") {
            return dark ? #FF64A02E : #FFE4EF;
        } else if (kind == "image") {
            return dark ? #78C8502E : #E4F4DA;
        } else if (kind == "live") {
            return dark ? #FF6B5E2E : #FFE5E2;
        }
        return dark ? #A0AAD229 : #E8EAF2;
    }

    public pure function kind-fg(kind: string) -> brush {
        if (kind == "disc") {
            return dark ? #8DB2FF : #2563C9;
        } else if (kind == "media") {
            return dark ? #BBA4FF : #6B3FD4;
        } else if (kind == "torrent" || kind == "magnet") {
            return dark ? #5AD8C2 : #0B7160;
        } else if (kind == "archive") {
            return dark ? #F5C25C : #92580A;
        } else if (kind == "music") {
            return dark ? #FF8DBB : #C0266D;
        } else if (kind == "image") {
            return dark ? #93D96B : #3B6D11;
        } else if (kind == "live") {
            return dark ? #FF8A7F : #C02B1E;
        }
        return dark ? #B4BCDB : #4A5372;
    }

    // The in-between tone: segment cells being fetched.
    public pure function kind-mid(kind: string) -> brush {
        if (kind == "disc") {
            return dark ? #8DB2FF73 : #93B4F0;
        } else if (kind == "media") {
            return dark ? #BBA4FF73 : #BCA3F3;
        } else if (kind == "torrent" || kind == "magnet") {
            return dark ? #5AD8C273 : #86D1C1;
        } else if (kind == "archive") {
            return dark ? #F5C25C73 : #EDC36F;
        } else if (kind == "music") {
            return dark ? #FF8DBB73 : #F29BBE;
        } else if (kind == "image") {
            return dark ? #93D96B73 : #A9D08A;
        } else if (kind == "live") {
            return dark ? #FF8A7F73 : #F2A49C;
        }
        return dark ? #B4BCDB66 : #AEB4CA;
    }
}
