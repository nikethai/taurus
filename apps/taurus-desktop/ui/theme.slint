import { Palette } from "std-widgets.slint";

// Design tokens. The fixed values from the spec are the light/dark ground
// (#FBFBFC / #1C1C1F), the Aldebaran accent (#E8590C / #C2410C) and the
// file-type colors. Everything else (the Cobalt, Jade, Grape, Rose and Sky
// accents, the panel/line/text/muted/chip/track/ok/err tokens, the kind
// light backgrounds at ~12% tint over the light ground, and the dark-mode
// kind variants) is DERIVED, pending the design canvas, and may be retuned
// when it becomes available.
export global Theme {
    // system (default, follows the OS) | light | dark
    in-out property <string> scheme: "system";
    // The OS is dark: followed until a light or dark theme is picked,
    // then kept as it was (the std widgets' palette then follows the
    // pick, see sync-palette).
    in-out property <bool> os-dark: Palette.color-scheme == ColorScheme.dark;
    in-out property <bool> dark: scheme == "dark" || (scheme != "light" && os-dark);
    property <bool> palette-set: false;

    // The std widgets (text fields, selects) take the theme's light or
    // dark palette once a light or dark theme was picked; until then
    // they, and the theme, follow the OS. Called after `scheme` changed.
    public function sync-palette() {
        if (self.scheme == "system" && !self.palette-set) {
            return;
        }
        if (!self.palette-set) {
            // Keeps the OS's scheme as it is now: the palette no longer
            // tells it once set.
            self.os-dark = self.os-dark;
            self.palette-set = true;
        }
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    // aldebaran (default) | cobalt | jade | grape | rose | sky
    in-out property <string> accent: "aldebaran";

    out property <brush> bg: dark ? #1C1C1F : #FBFBFC;
    out property <brush> panel: dark ? #26262B : #FFFFFF;
    out property <brush> line: dark ? #34343B : #E6E6EA;
    out property <brush> text: dark ? #F2F2F4 : #1B1B1F;
    out property <brush> muted: dark ? #9A9AA6 : #6B6B76;
    out property <brush> chip: dark ? #2E2E34 : #F0F0F3;
    out property <brush> track: dark ? #3A3A41 : #E8E8EC;
    out property <brush> ok: dark ? #4CC38A : #1E8E5A;
    out property <brush> err: dark ? #F2705F : #C02B1E;
    // Soft shadow under floating cards (banner, countdown).
    out property <color> shadow: dark ? #00000066 : #0000001F;
    // Dims the window behind a dialog.
    out property <color> scrim: dark ? #000000A0 : #00000059;

    // Swatch color of an accent by name; unknown names are Aldebaran.
    public pure function accent-of(name: string) -> color {
        if (name == "cobalt") {
            return #2F6FE4;
        } else if (name == "jade") {
            return #0E9F6E;
        } else if (name == "grape") {
            return #8B5CF6;
        } else if (name == "rose") {
            return #E11D74;
        } else if (name == "sky") {
            return #0EA5E9;
        }
        return #E8590C;
    }

    property <color> accent-raw: accent-of(accent);
    property <color> accent-strong-raw: accent == "cobalt" ? #1D4FB8
        : accent == "jade" ? #047857
        : accent == "grape" ? #6D28D9
        : accent == "rose" ? #BE185D
        : accent == "sky" ? #0369A1
        : #C2410C;

    out property <brush> accent-base: accent-raw;
    // Strong tone for hover/pressed and accent-colored text; lighter on dark.
    out property <brush> accent-strong: dark ? accent-raw.brighter(0.3) : accent-strong-raw;
    // Text/icon color placed on an accent fill.
    out property <brush> accent-text: #FFFFFF;
    out property <brush> accent-soft: accent-raw.with-alpha(dark ? 0.2 : 0.12);
    out property <brush> sel: accent-raw.with-alpha(dark ? 0.28 : 0.16);
    // Progress bars take their file kind's color (ui.progress_by_type),
    // else the accent.
    in-out property <bool> by-type: true;

    public pure function bar(kind: string) -> brush {
        return by-type ? kind-fg(kind) : accent-base;
    }

    // Kinds: disc, media, torrent (also magnet), archive, music, image, live;
    // anything else is "file".
    public pure function kind-bg(kind: string) -> brush {
        if (kind == "disc") {
            return dark ? #1E2C44 : #E1E9F6;
        } else if (kind == "media") {
            return dark ? #2D2447 : #EAE4F7;
        } else if (kind == "torrent" || kind == "magnet") {
            return dark ? #182F2D : #DEEAE9;
        } else if (kind == "archive") {
            return dark ? #36291A : #EEE7DF;
        } else if (kind == "music") {
            return dark ? #401E30 : #F4E1EB;
        } else if (kind == "image") {
            return dark ? #232E1C : #E4EAE0;
        } else if (kind == "live") {
            return dark ? #401F1F : #F4E2E1;
        }
        return dark ? #262831 : #E6E7EB;
    }

    public pure function kind-fg(kind: string) -> brush {
        if (kind == "disc") {
            return dark ? #87A9E1 : #2563C9;
        } else if (kind == "media") {
            return dark ? #AE95E7 : #6B3FD4;
        } else if (kind == "torrent" || kind == "magnet") {
            return dark ? #79B1A8 : #0B7160;
        } else if (kind == "archive") {
            return dark ? #C3A378 : #92580A;
        } else if (kind == "music") {
            return dark ? #DC88AF : #C0266D;
        } else if (kind == "image") {
            return dark ? #93AF7C : #3B6D11;
        } else if (kind == "live") {
            return dark ? #DC8A83 : #C02B1E;
        }
        return dark ? #9BA0B1 : #4A5372;
    }
}
